<Window x:Class="Task8.EditGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="500" Width="600" Background="#ECEFF1">
    <Window.Resources>
        <!-- Primary button style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Edit Group" FontSize="20" FontWeight="Bold" Margin="10"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10">
            <TextBox x:Name="GroupNameTextBox" Margin="0,5,0,5" Width="300" Text="Name"/>

            <ComboBox x:Name="CourseComboBox" Width="300">
                <ComboBoxItem Content="Select Course" IsEnabled="False"/>
            </ComboBox>

            <ComboBox x:Name="TeacherComboBox" Margin="0,5,0,5" Width="300"
                      DisplayMemberPath="Name" SelectedValuePath="TeacherId"
                      SelectedValue="{Binding TeacherId}">
                <ComboBoxItem Content="Select Teacher" IsEnabled="False"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Save" Click="SaveButton_Click" Width="62" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}" Height="25"/>
            <Button Content="Delete" Click="DeleteButton_Click" Width="59" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Cancel" Click="CancelButton_Click" Width="62" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button x:Name="ExportCsvButton" Content="Export to CSV" Margin="0,0,7,0" Click="ExportCsvButton_Click" Width="153" Style="{StaticResource PrimaryButtonStyle}" Height="25"/>
            <Button x:Name="ImportCsvButton" Content="Import from CSV" Margin="0,0,7,0" Click="ImportCsvButton_Click" Style="{StaticResource PrimaryButtonStyle}" Height="25" Width="140"/>
            <Button x:Name="GenerateDocButton" Content="Group List (DOCX)" Click="GenerateDocButton_Click" Style="{StaticResource PrimaryButtonStyle}" Height="25" Width="130"/>
            <Button x:Name="GeneratePdfButton" Content="Group List (PDF)" Click="GeneratePdfButton_Click" Style="{StaticResource PrimaryButtonStyle}" Height="25" Width="120" Margin="10,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="GroupListBox" Grid.Row="4" Margin="10"/>
    </Grid>
</Window>

