<Window x:Class="Task8.EditTeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Teachers" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Teacher Name" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox Name="TeacherNameTextBox" Margin="0,0,0,20"/>

            <TextBlock Text="Teacher Surname" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox Name="TeacherSurnameTextBox" Margin="0,0,0,20"/>

            <TextBlock Text="Group" FontWeight="Bold" Margin="0,0,0,10"/>
            <ComboBox Name="GroupComboBox" Margin="0,0,0,20"/>

            <Button Content="Save" Width="100" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
