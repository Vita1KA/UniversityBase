<Window x:Class="Task8.EditStudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Students" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Student Name" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox Name="StudentNameTextBox" Margin="0,0,0,20"/>

            <TextBlock Text="Student Surname" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBox Name="StudentSurnameTextBox" Margin="0,0,0,20"/>

            <TextBlock Text="Group" FontWeight="Bold" Margin="0,0,0,10"/>
            <ComboBox Name="GroupComboBox" Margin="0,0,0,20"/>

            <Button Content="Save" Width="100" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
